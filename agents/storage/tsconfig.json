{
	"compilerOptions": {
		"target": "es2024",
		"lib": ["es2024"],
		"jsx": "react-jsx",
		/*
		 * The published package runs directly in Node (the `client`/`admin`
		 * entrypoints), not only through a bundler, so relative imports must
		 * carry `.js` extensions to resolve at runtime. `nodenext` makes tsc
		 * enforce that instead of leaving it to fail on the consumer's machine.
		 */
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"resolveJsonModule": true,
		"allowJs": true,
		"checkJs": false,
		"noEmit": true,
		"isolatedModules": true,
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true,
		"types": ["./worker-configuration.d.ts", "node"]
	},

	/*
	 * `dist` is this project's own build output - with allowJs on it would be
	 * typechecked alongside the sources it was emitted from. `template` holds
	 * files meant to be copied into a consumer's project, so they import
	 * `@frostbase-dev/storage` by package name, which does not resolve from
	 * inside the package itself.
	 */
	"exclude": ["dist", "template", "node_modules"]
}
