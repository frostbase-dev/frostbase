{
	"name": "@frostbase-dev/db",
	"version": "0.7.1",
	"description": "Documents with live queries and schema-first SQL tables on Cloudflare Durable Objects, one isolated instance per collection or table - the database primitive behind Frostbase.",
	"license": "Apache-2.0",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/frostbase-dev/frostbase.git",
		"directory": "agents/db"
	},
	"homepage": "https://github.com/frostbase-dev/frostbase/tree/main/agents/db#readme",
	"bugs": "https://github.com/frostbase-dev/frostbase/issues",
	"keywords": [
		"cloudflare",
		"workers",
		"durable-objects",
		"database",
		"realtime",
		"live-queries",
		"agents",
		"frostbase"
	],
	"publishConfig": {
		"access": "public"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"default": "./dist/client.js"
		},
		"./admin": {
			"types": "./dist/admin.d.ts",
			"default": "./dist/admin.js"
		},
		"./drizzle": {
			"types": "./dist/drizzle.d.ts",
			"default": "./dist/drizzle.js"
		},
		"./wrangler-fragment.jsonc": "./template/wrangler-fragment.jsonc",
		"./frostbase.agent.json": "./frostbase.agent.json",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"template",
		"NOTICE",
		"frostbase.agent.json"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "npm run build",
		"test:unit": "node --import tsx --test src/route-access.unit.test.ts src/access.unit.test.ts src/remote-config.unit.test.ts src/remote-config-eval.unit.test.ts src/remote-config-client.unit.test.ts src/query.unit.test.ts src/rules.unit.test.ts src/uuidv7.unit.test.ts src/table-schema.unit.test.ts src/table-query.unit.test.ts src/replication.unit.test.ts src/table-sql.unit.test.ts",
		"deploy": "wrangler deploy",
		"dev": "wrangler dev --env local --persist-to=../../.wrangler/state/ --ip 0.0.0.0 --port 8789",
		"start": "wrangler dev",
		"cf-typegen": "wrangler types",
		"dev:test": "wrangler dev --env test --ip 127.0.0.1 --port 8799 --persist-to ../../.wrangler/test-state/db-agent",
		"deploy:production": "wrangler deploy --env production",
		"migrations": "drizzle-kit generate && node scripts/generate-migrations.mjs"
	},
	"devDependencies": {
		"@types/node": "^26.1.1",
		"drizzle-kit": "^0.31.10",
		"tsx": "^4.20.0",
		"typescript": "^5.5.2",
		"wrangler": "^4.118.0"
	},
	"dependencies": {
		"@sentry/cloudflare": "^10.66.0",
		"agents": "^0.17.4",
		"drizzle-orm": "^0.45.2",
		"jose": "^6.0.11",
		"uuid": "^14.0.1",
		"zod": "^4.4.3"
	}
}
